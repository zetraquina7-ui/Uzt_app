                YouTubeSubCategory(
                    key = "pt_amigos",
                    name = "Amigos",
                    emoji = "🤝",
                    accentColor = Color(0xFF10B981),
                    playlistList = listOf(
                        "PLAXFI56mD-HQ" to "Amigos"
