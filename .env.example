# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
MY_GEMINI_KEY=MY_GEMINI_API_KEY

# YouTube Data API v3 Key (for automatic fetching of @zetraquina videos and shorts)
YOUTUBE_API_KEY=DEFAULT_KEY
# YouTube Channel ID (optional, defaults to @zetraquina handle resolution)
YOUTUBE_CHANNEL_ID=DEFAULT_ID
